{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/cc-sdd-session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "password-form-repair@nekono-dev": true,
    "branch-release-workflow@nekono-dev": true
  },
  "extraKnownMarketplaces": {
    "nekono-dev": {
      "source": {
        "source": "github",
        "repo": "nekono-dev/claude-plugins"
      }
    }
  }
}
