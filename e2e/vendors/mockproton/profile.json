{
  "vendor": "mockproton",
  "displayName": "Proton VPN（モック）",
  "binary": "/usr/local/bin/protonvpn-mock",
  "outputFormat": "text",
  "loginMethod": "credentials",
  "output": {
    "connectedPattern": "(?<![a-zA-Z])connected(?![a-zA-Z])",
    "locationPattern": "^(?:Server:|Connected to)\\s+(.+?)\\.?\\s*$"
  },
  "features": { "changeLocation": true, "locationPing": false },
  "actions": {
    "connect": {
      "argv": ["connect", "%LOCATION%"],
      "placeholders": { "LOCATION": { "pattern": "^[A-Za-z0-9#-]{1,64}$", "source": "locations" } },
      "timeoutMs": 90000,
      "restrictedPattern": "not available on the free plan"
    },
    "connectAuto": { "argv": ["connect"], "placeholders": {}, "timeoutMs": 90000 },
    "disconnect": { "argv": ["disconnect"], "placeholders": {}, "timeoutMs": 30000, "successPattern": "^Disconnected\\." },
    "status": { "argv": ["status"], "placeholders": {}, "timeoutMs": 15000 },
    "login": {
      "argv": ["signin", "--totp", "%USERNAME%"],
      "placeholders": {
        "USERNAME": { "pattern": "^[^\\-\\s\\x00-\\x1f\\x7f][^\\s\\x00-\\x1f\\x7f]{0,127}$", "source": "input" },
        "PASSWORD": { "pattern": "^[^\\x00-\\x1f\\x7f]{1,512}$", "source": "secret" },
        "TWO_FACTOR_CODE": { "pattern": "^[0-9A-Za-z]{4,32}$", "source": "secret", "optional": true }
      },
      "stdin": ["%PASSWORD%", "%TWO_FACTOR_CODE%"],
      "timeoutMs": 60000
    },
    "logout": { "argv": ["signout"], "placeholders": {}, "timeoutMs": 30000 },
    "listLocations": {
      "argv": ["countries", "list"],
      "placeholders": {},
      "timeoutMs": 30000,
      "table": { "iso": "Code", "country": "Country" },
      "connectName": { "from": "iso" },
      "restrictedPattern": "not available on the free plan"
    },
    "listCities": {
      "argv": ["cities", "list", "--country", "%LOCATION%"],
      "placeholders": { "LOCATION": { "pattern": "^[A-Za-z]{2}$", "source": "locations" } },
      "timeoutMs": 30000,
      "table": { "city": "City", "features": "Features" }
    },
    "account": {
      "argv": ["config", "list"],
      "placeholders": {},
      "timeoutMs": 15000,
      "notLoggedInPattern": "Authentication required",
      "plans": [
        {
          "id": "free",
          "label": "Free",
          "pattern": "Upgrade to enable|To upgrade to VPN Plus",
          "restricts": ["connectToLocation", "locationList"],
          "restrictionMessage": "無料プランでは接続先を選べません。最速の無料サーバへ自動接続します。",
          "availableLocations": {
            "file": "VPN/serverlist.json",
            "list": "LogicalServers",
            "country": "ExitCountry",
            "city": "City",
            "where": [{ "field": "Tier", "equals": 0 }, { "field": "Status", "equals": 1 }]
          }
        }
      ],
      "defaultPlan": { "id": "paid", "label": "Paid" }
    }
  },
  "serverCatalog": {
    "file": "VPN/serverlist.json",
    "list": "LogicalServers",
    "name": "Name",
    "country": "ExitCountry",
    "city": "City",
    "tier": "Tier",
    "features": "Features",
    "status": "Status",
    "score": "Score",
    "load": "Load"
  },
  "locationTarget": { "city": "fastestServer", "unavailableFavorite": "error", "errorProvider": "proton" }
}
