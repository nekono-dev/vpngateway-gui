# 検証サーバへの反映スクリプト（scripts/deploy-verify.sh）の設定。`.env`へコピーして値を設定する。
# `.env`はgit管理外。反映時に検証サーバの`.env`（インストーラが生成するもの）を上書きしないよう、転送対象から除外している。
VERIFY_HOST=192.168.3.240
VERIFY_USER=ubuntu
# 空ならパスワードを使わず通常のssh（鍵認証等）で接続する。設定するとsshpassを使う。
VERIFY_SSH_PASSWORD=
# 検証サーバ上のインストール先（実スタック）。
VERIFY_INSTALL_DIR=/opt/vpngwgui
