# 責務: 単一ノード Compose と検証反映の任意設定例を提供する（秘密鍵や認証情報は含めない）。
# `.env`はgit管理外。Compose 設定に使う値を有効化して編集する。
# TLS flag の既定値は両方 false。TLS を有効にするときは該当 fragment も Compose に追加する。
WEB_HTTPS_ENABLED=false
WEB_PORT=8080
# WEB_HTTPS_ENABLED=true の場合:
# COMPOSE_FILE=docker-compose.yml:compose/web-tls.yml
# WEB_TLS_CERT_HOST_PATH=/absolute/path/to/web-server.crt
# WEB_TLS_KEY_HOST_PATH=/absolute/path/to/web-server.key

GATEWAY_TLS_ENABLED=false
# GATEWAY_TLS_ENABLED=true の場合:
# COMPOSE_FILE=docker-compose.yml:compose/api-tls.yml
# GATEWAY_TLS_CA_HOST_PATH=/absolute/path/to/gateway-ca.crt
# GATEWAY_TLS_CLIENT_CERT_HOST_PATH=/absolute/path/to/api-client.crt
# GATEWAY_TLS_CLIENT_KEY_HOST_PATH=/absolute/path/to/api-client.key
# GATEWAY_TLS_SERVER_CERT_HOST_PATH=/absolute/path/to/gateway-server.crt
# GATEWAY_TLS_SERVER_KEY_HOST_PATH=/absolute/path/to/gateway-server.key
# GATEWAY_TLS_SERVER_NAME=gateway.local

VPN_PROVIDERS=
LAN_IFACE=

# 検証サーバへの反映スクリプト（scripts/deploy-verify.sh）の設定。
VERIFY_HOST=192.168.3.240
VERIFY_USER=ubuntu
# 空ならパスワードを使わず通常のssh（鍵認証等）で接続する。設定するとsshpassを使う。
VERIFY_SSH_PASSWORD=
VERIFY_INSTALL_DIR=/opt/vpngwgui
