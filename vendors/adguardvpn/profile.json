{
  "vendor": "adguardvpn",
  "displayName": "AdGuard VPN",
  "binary": "/usr/local/bin/adguardvpn-cli",
  "outputFormat": "text",
  "loginMethod": "deviceUrl",
  "output": {
    "connectedPattern": "(?<![a-zA-Z])connected(?![a-zA-Z])",
    "locationPattern": "(?<![a-zA-Z])Connected to (.+?)(?: in \\S+ mode|\\s*$)"
  },
  "actions": {
    "connect": {
      "argv": [
        "connect",
        "-l",
        "%LOCATION%",
        "-y"
      ],
      "placeholders": {
        "LOCATION": {
          "pattern": "^[^\\-\\s\\x00-\\x1f\\x7f][^\\x00-\\x1f\\x7f]{0,62}$",
          "source": "locations"
        }
      },
      "timeoutMs": 30000
    },
    "disconnect": {
      "argv": [
        "disconnect"
      ],
      "placeholders": {},
      "timeoutMs": 15000
    },
    "status": {
      "argv": [
        "status"
      ],
      "placeholders": {},
      "timeoutMs": 8000,
      "successPattern": "You are not logged in|not logged in"
    },
    "login": {
      "argv": [
        "login"
      ],
      "placeholders": {},
      "timeoutMs": 15000,
      "completionPattern": "https://auth\\.adguard\\.io/device_code\\?user_code=[A-Z0-9-]+"
    },
    "logout": {
      "argv": [
        "logout"
      ],
      "placeholders": {},
      "timeoutMs": 15000
    },
    "listLocations": {
      "argv": [
        "list-locations"
      ],
      "placeholders": {},
      "timeoutMs": 15000,
      "table": {
        "iso": "ISO",
        "country": "COUNTRY",
        "city": "CITY",
        "ping": "PING"
      },
      "connectName": {
        "from": "city",
        "stripPattern": "\\s*\\(Virtual\\)\\s*$"
      }
    },
    "account": {
      "argv": [
        "license"
      ],
      "placeholders": {},
      "timeoutMs": 10000,
      "notLoggedInPattern": "Please log in|not logged in",
      "plans": [
        {
          "id": "premium",
          "label": "Premium",
          "pattern": "using the PREMIUM version",
          "restricts": []
        },
        {
          "id": "free",
          "label": "Free",
          "pattern": "using the FREE version",
          "restricts": [],
          "usageNote": {
            "pattern": "(You have .+ left for this month)"
          }
        }
      ],
      "defaultPlan": {
        "id": "unknown",
        "label": "不明"
      }
    }
  }
}
