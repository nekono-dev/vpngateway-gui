node_modules/
dist/
dist-server/
*.tsbuildinfo

# APIサーバが自動生成するOpenAPI仕様（ビルド時生成）
api/openapi.json

# orvalが自動生成するAPIクライアント（手動編集禁止、ビルド時生成）
web/src/generated/

# Phase1のユーザ向け設定・監査ログ永続化ファイル（ローカル実行時にホストへ書き出す場合）
*.local.json

# install/detect-lan-interface.shが対象ホストごとに書き出すLAN側インターフェース設定（環境依存。
# docker composeが自動読み込みする.envファイル経由でproxyコンテナのLAN_IFACE/WAN_IFACEへ渡す）
.env

# Playwrightの実ブラウザのテストの出力
test-results/
playwright-report/

.claude/skills/kiro-*/
.agents/skills/kiro-*/
# E2E（hosted・vendor-live）の成果物（スクリーンショット・トレース・診断・結果の JSON）
e2e/artifacts/

# hosted E2E の証明書・秘密鍵の作業場所（実行ごとに作り直す。git の対象外）
e2e/hosted/.work/
